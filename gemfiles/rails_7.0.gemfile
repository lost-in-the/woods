# frozen_string_literal: true

# Hand-maintained Rails-version gemfile (appraisal can't generate from the
# conditional base Gemfile). Inherits the base Gemfile's dev/test gems via
# eval_gemfile and pins Rails. Keep the Rails pins in sync with ../Appraisals.

source 'https://rubygems.org'

# Rails < 7.1 pins `sqlite3 ~> 1.4` in its adapter at load time; hold the base
# Gemfile to the 1.x line for this row (read by ../Gemfile before resolution).
ENV['WOODS_SQLITE3_REQ'] ||= '~> 1.4'

eval_gemfile File.expand_path('../Gemfile', __dir__)

gem 'rails', '~> 7.0.0'
# Rails < 7.1 relies on concurrent-ruby's implicit `require "logger"`, which
# 1.3.5 removed; pin below it so the app boots on Ruby 3.x.
gem 'concurrent-ruby', '< 1.3.5'
