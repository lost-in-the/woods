#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'open3'

class ReleaseRunValidationError < StandardError; end

# The trusted default-branch CI contract this candidate run must have
# actually executed. A CI run's `workflow_id` alone proves the run belongs
# to *some* revision of .github/workflows/ci.yml at that path, not that the
# revision tested on the candidate ref carried the full trusted job set - a
# candidate branch/tag can edit ci.yml down to a handful of jobs without
# changing its path or its GitHub-assigned workflow_id. Job *names* are
# matched by prefix because a matrixed job (e.g. the Ruby version matrix)
# reports one job per matrix cell, each suffixed with its cell's values.
TRUSTED_CI_WORKFLOW_PATH = '.github/workflows/ci.yml'
TRUSTED_CI_WORKFLOW_NAME = 'CI'
REQUIRED_CI_JOBS = {
  'test' => 'Unit specs (Ruby ',
  'live-backends' => 'Live backends (pgvector + Qdrant + Solid Cache)',
  'http-transport' => 'MCP transports (official clients)',
  'coverage' => 'coverage',
  'security' => 'security',
  'lint' => 'lint',
  'build' => 'build'
}.freeze

RELEASE_ENVIRONMENT = 'release'

def fail_validation(message)
  raise ReleaseRunValidationError, message
end

def required_env(name)
  value = ENV.fetch(name, '').strip
  fail_validation("#{name} is required") if value.empty?

  value
end

def github_api(endpoint)
  stdout, stderr, status = Open3.capture3('gh', 'api', '--method', 'GET', endpoint)
  fail_validation("GitHub API request failed for #{endpoint}: #{stderr.strip}") unless status.success?

  JSON.parse(stdout)
rescue Errno::ENOENT => e
  fail_validation("GitHub API request failed: #{e.message}")
rescue JSON::ParserError => e
  fail_validation("GitHub API returned invalid JSON for #{endpoint}: #{e.message}")
end

begin
  run_id = required_env('CI_RUN_ID')
  tag = required_env('RELEASE_TAG')
  repository = required_env('GITHUB_REPOSITORY')
  output_path = required_env('GITHUB_OUTPUT')

  fail_validation('CI_RUN_ID must be a positive integer') unless run_id.match?(/\A[1-9]\d*\z/)
  fail_validation('RELEASE_TAG must be a version tag') unless tag.match?(/\Av[0-9A-Za-z][0-9A-Za-z._-]*\z/)
  unless repository.match?(%r{\A[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\z})
    fail_validation('GITHUB_REPOSITORY must be an owner/name pair')
  end

  run = github_api("/repos/#{repository}/actions/runs/#{run_id}")
  workflow = github_api("/repos/#{repository}/actions/workflows/ci.yml")

  fail_validation("returned run ID #{run['id']}, expected #{run_id}") unless run['id'].to_s == run_id
  unless run['workflow_id'].to_s == workflow['id'].to_s
    fail_validation("CI run #{run_id} does not belong to .github/workflows/ci.yml")
  end

  run_workflow_path = run['path'].to_s
  unless run_workflow_path == TRUSTED_CI_WORKFLOW_PATH
    fail_validation("CI run #{run_id} ran workflow #{run_workflow_path}, expected #{TRUSTED_CI_WORKFLOW_PATH}")
  end
  workflow_path = workflow['path'].to_s
  if workflow_path != TRUSTED_CI_WORKFLOW_PATH
    fail_validation("CI run #{run_id} workflow definition path is #{workflow_path}, " \
                    "expected #{TRUSTED_CI_WORKFLOW_PATH}")
  end
  workflow_name = workflow['name'].to_s
  if workflow_name != TRUSTED_CI_WORKFLOW_NAME
    fail_validation("CI run #{run_id} workflow name is #{workflow_name.inspect}, " \
                    "expected #{TRUSTED_CI_WORKFLOW_NAME.inspect}")
  end

  run_jobs = github_api("/repos/#{repository}/actions/runs/#{run_id}/jobs").fetch('jobs', [])
  REQUIRED_CI_JOBS.each do |job_id, name_prefix|
    matches = run_jobs.select { |job| job['name'].to_s.start_with?(name_prefix) }
    if matches.empty?
      fail_validation(
        "CI run #{run_id} has no job matching required CI contract job #{job_id.inspect} " \
        "(expected a job name starting with #{name_prefix.inspect})"
      )
    end
    failed = matches.reject { |job| job['conclusion'] == 'success' }
    next if failed.empty?

    fail_validation(
      "CI run #{run_id} job #{failed.first['name'].inspect} concluded #{failed.first['conclusion']}, " \
      "expected success for required CI contract job #{job_id.inspect}"
    )
  end

  unless run['conclusion'] == 'success'
    fail_validation("CI run #{run_id} conclusion is #{run['conclusion']}, expected success")
  end
  fail_validation("CI run #{run_id} event is #{run['event']}, expected push") unless run['event'] == 'push'
  unless run['head_branch'] == tag
    fail_validation("CI run #{run_id} tested ref is #{run['head_branch']}, expected #{tag}")
  end

  release_sha = run['head_sha'].to_s
  fail_validation("CI run #{run_id} head SHA is not a full Git SHA") unless release_sha.match?(/\A[0-9a-f]{40}\z/)

  head_repository = run.dig('head_repository', 'full_name')
  unless head_repository == repository
    fail_validation("CI run #{run_id} head repository is #{head_repository}, expected #{repository}")
  end
  run_repository = run.dig('repository', 'full_name')
  unless run_repository == repository
    fail_validation("CI run #{run_id} repository is #{run_repository}, expected #{repository}")
  end

  # Task 10: resolve one immutable artifact identity here, once, so every
  # downstream job (package-test, publish) downloads the literal same
  # artifact object no matter what happens to the run afterward (e.g. a
  # rerun re-uploading a same-named artifact). Name + run-id alone cannot
  # guarantee that: two jobs resolving "the artifact named X in run Y" at
  # different points in time can disagree if the run was rerun in between.
  artifact_name = "woods-release-#{release_sha}"
  artifacts = github_api("/repos/#{repository}/actions/runs/#{run_id}/artifacts").fetch('artifacts', [])
  named_artifacts = artifacts.select { |candidate| candidate['name'] == artifact_name }

  fail_validation("no artifact named #{artifact_name} exists in CI run #{run_id}") if named_artifacts.empty?
  if named_artifacts.length > 1
    fail_validation(
      "#{named_artifacts.length} artifacts named #{artifact_name} exist in CI run #{run_id}, expected exactly one"
    )
  end

  artifact = named_artifacts.first
  artifact_id = artifact['id']
  artifact_digest = artifact['digest'].to_s

  # The GitHub API's digest covers the whole uploaded artifact archive (here:
  # the gem plus its co-shipped .sha256 sidecar), not one file inside it, so
  # it cannot be diffed byte-for-byte against the extracted gem. It is still
  # required and fails closed when absent: an artifact GitHub can't attest a
  # digest for is not one we trust on the strength of its own sidecar file.
  if artifact_digest.strip.empty?
    fail_validation(
      "artifact #{artifact_name} (id #{artifact_id}) in CI run #{run_id} has no digest in the GitHub API " \
      'response; refusing to fall back to the artifact-internal .sha256 file as the trust anchor'
    )
  end

  # Fail closed rather than publish behind a gate that only looks locked: an
  # environment with no protection rules approves every deployment the
  # instant it is requested, and admin bypass lets one identity route around
  # whatever rules do exist. Detection only - changing the live environment's
  # settings is outside this script's authority.
  release_environment = github_api("/repos/#{repository}/environments/#{RELEASE_ENVIRONMENT}")
  if release_environment.fetch('protection_rules', []).empty?
    fail_validation(
      "live '#{RELEASE_ENVIRONMENT}' environment has no protection rules configured; add a required " \
      'reviewers rule (or another protection rule) in the environment settings and request approval ' \
      'before publishing'
    )
  end
  if release_environment.fetch('can_admins_bypass', false)
    fail_validation(
      "live '#{RELEASE_ENVIRONMENT}' environment allows administrators to bypass protection rules; " \
      'disable admin bypass in the environment settings and request approval before publishing'
    )
  end

  File.open(output_path, 'a') do |output|
    output.puts "release-sha=#{release_sha}"
    output.puts "ci-run-id=#{run_id}"
    output.puts "tag=#{tag}"
    output.puts "artifact-name=#{artifact_name}"
    output.puts "artifact-id=#{artifact_id}"
    output.puts "artifact-digest=#{artifact_digest}"
  end

  puts "Validated CI run #{run_id} for #{tag} at #{release_sha}"
rescue KeyError, ReleaseRunValidationError => e
  warn "Release run validation failed: #{e.message}"
  exit 1
end
