#!/usr/bin/env ruby
# frozen_string_literal: true

# Preflight entry point for the Woods Index MCP server: it validates the index
# directory and its published manifest, then `exec`s woods-mcp in place. There
# is no supervision and no restart loop — a crashed woods-mcp stays down, the
# same as when launched directly. RubyGems loads gem executables as Ruby, so
# this wrapper must remain a Ruby program when packaged.

require_relative '../lib/woods/mcp/served_identity'

USAGE = 'Usage: woods-mcp-start [--allow-mismatch] [--await-index] [--client-root PATH [--client-root-as PATH]] ' \
        '(--checkout | /path/to/index_dir)'

def usage_error(message)
  warn "Error: #{message}"
  warn USAGE
  exit 1
end

# Removes `name VALUE` or `name=VALUE` from ARGV and returns the value.
def take_option(name)
  position = ARGV.index { |arg| arg == name || arg.start_with?("#{name}=") }
  return unless position

  argument = ARGV.delete_at(position)
  value = argument == name ? ARGV.delete_at(position) : argument.delete_prefix("#{name}=")
  usage_error("#{name} needs a path") if value.nil? || value.empty? || value.start_with?('--')
  value
end

# `--allow-mismatch` (or WOODS_MCP_ALLOW_MISMATCH=1) serves an index that
# another checkout of the repository recorded; without it that is refused.
allow_mismatch = !ARGV.delete('--allow-mismatch').nil?

# `--await-index` (or WOODS_MCP_AWAIT_INDEX=1): a directory that holds no
# published index yet, or does not exist, is not an error. woods-mcp starts,
# answers `building` until an index is published there, then serves it.
await_index_env = 'WOODS_MCP_AWAIT_INDEX'
await_index = !ARGV.delete('--await-index').nil? || Woods::MCP::ServedIdentity.env_flag?(await_index_env)

# `--client-root` (or WOODS_MCP_CLIENT_ROOT) is the directory the client
# session runs in: the index is compared with that checkout instead of this
# launcher's own directory, which a launcher inside a shared container always
# shares with the index it mounts. `--client-root-as` (or
# WOODS_MCP_CLIENT_ROOT_AS) is where this process sees that directory. Both
# reach woods-mcp through the environment, as the mismatch override does.
client_root_env = Woods::MCP::ServedIdentity::CLIENT_ROOT_ENV
client_root_as_env = Woods::MCP::ServedIdentity::CLIENT_ROOT_AS_ENV
{ '--client-root-as' => client_root_as_env, '--client-root' => client_root_env }.each do |flag, variable|
  value = take_option(flag)
  ENV[variable] = value if value
end
declared_client_root = ENV.fetch(client_root_env, '').strip
mapped_client_root = ENV.fetch(client_root_as_env, '').strip
if declared_client_root.empty?
  usage_error('--client-root-as needs --client-root (WOODS_MCP_CLIENT_ROOT)') unless mapped_client_root.empty?
elsif !declared_client_root.start_with?('/')
  usage_error("--client-root must be an absolute path as the client sees it, got #{declared_client_root}")
end
ENV[client_root_as_env] = File.expand_path(mapped_client_root) unless mapped_client_root.empty?

# `--checkout` (or WOODS_MCP_CHECKOUT=1) takes no index path: it serves the
# index of the checkout this launcher runs in (the nearest directory holding
# `.git`, so a linked worktree is its own checkout), at WOODS_OUTPUT resolved
# against that checkout, else `tmp/woods`. It never serves another tree's.
checkout_mode = !ARGV.delete('--checkout').nil? || Woods::MCP::ServedIdentity.env_flag?('WOODS_MCP_CHECKOUT')
if checkout_mode
  given = ARGV[0] || ENV.fetch('WOODS_DIR', nil)
  usage_error("--checkout takes no index path, got #{given}") unless given.nil? || given.empty?

  checkout = Woods::MCP::ServedIdentity.checkout_root(Dir.pwd)
  unless checkout
    warn "Error: --checkout serves the current checkout's index, but #{Dir.pwd} is not inside a git checkout."
    warn 'Run the server from inside the checkout, or pass the index directory as a path instead of --checkout.'
    exit 1
  end

  output = ENV.fetch('WOODS_OUTPUT', '').strip
  index_dir = File.expand_path(output.empty? ? 'tmp/woods' : output, checkout)
  # The checkout is a real path; compare the index's, when it exists.
  index_dir = File.realpath(index_dir) if File.exist?(index_dir)
  unless index_dir.start_with?("#{checkout}#{File::SEPARATOR}")
    usage_error("--checkout serves the checkout's own index, but WOODS_OUTPUT names #{index_dir}, " \
                "outside the checkout #{checkout}")
  end
end
index_dir ||= ARGV[0] || ENV.fetch('WOODS_DIR', nil) || ENV.fetch('WOODS_OUTPUT', nil)

if index_dir.nil? || index_dir.empty?
  warn 'Error: No index directory specified.'
  warn USAGE
  exit 1
end

index_dir = File.expand_path(index_dir)
path_remedy = 'Point at the existing index with an explicit path, WOODS_DIR, or WOODS_OUTPUT. ' \
              'If no index exists, run `bundle exec rake woods:extract` in your Rails app.'

unless await_index || File.directory?(index_dir)
  warn "Error: Index directory does not exist: #{index_dir}"
  warn path_remedy
  exit 1
end

# Mirrors Woods::Generation#payload_dir + Woods::MCP::Bootstrapper.manifest_present?
# (lib/woods/generation.rb, lib/woods/mcp/bootstrapper.rb) without requiring
# the gem: this pre-flight runs before the `exec` below, so pulling in the
# whole library just to check one file is wasted work on every boot. A
# payload-born index has no manifest.json at the root — it lives under the
# directory generation.json's `payload` pointer names — so the pointer is
# followed here too, with the same realpath containment check, before concluding the
# directory holds no index. woods-mcp re-checks this properly through
# Bootstrapper regardless; this is just an early, friendlier exit.
def manifest_present?(index_dir)
  return true if File.file?(File.join(index_dir, 'manifest.json'))

  generation_path = File.join(index_dir, 'generation.json')
  return false unless File.file?(generation_path)

  require 'json'
  require_relative '../lib/woods/atomic_file'
  payload_name = JSON.parse(Woods::AtomicFile.read(generation_path))['payload']
  return false unless payload_name.is_a?(String) && !payload_name.empty?

  root = File.realpath(index_dir)
  candidate = File.realpath(payload_name, root)
  return false unless candidate.start_with?("#{root}#{File::SEPARATOR}")

  File.file?(File.join(candidate, 'manifest.json'))
rescue JSON::ParserError, SystemCallError, TypeError, NoMethodError
  false
end

if await_index
  ENV[await_index_env] = '1'
  warn "Note: no published Woods index in #{index_dir} yet; serving it once one is." unless manifest_present?(index_dir)
elsif !manifest_present?(index_dir)
  warn "Error: Could not resolve a published Woods index in: #{index_dir}"
  warn 'Expected generation.json pointing to a payload manifest.json, or a legacy flat manifest.json.'
  warn path_remedy
  exit 1
end

# Which checkout the index describes, against the client's checkout (the
# declared client root, else the directory this launcher runs in). Reads
# generation.json, the manifest and the checkout's HEAD file only, so the
# handshake stays fast. A root mismatch is refused unless allowed; a branch
# difference, a checkout that cannot be determined or a writer from another
# Woods build is a warning (the server repeats each to the client at connect).
identity = Woods::MCP::ServedIdentity.read(index_dir)
allow_mismatch ||= Woods::MCP::ServedIdentity.allow_mismatch?
if identity.client_matches == false
  unless allow_mismatch
    warn "Error: #{identity.refusal_message}"
    exit 1
  end

  ENV[Woods::MCP::ServedIdentity::ALLOW_ENV] = '1'
  warn "Warning: serving another checkout's index (mismatch allowed). #{identity.warnings.first}"
end
identity.warnings.drop(identity.client_matches == false ? 1 : 0).each { |message| warn "Warning: #{message}" }

if ENV['MCP_PROTOCOL_VERSION'] && !ENV['MCP_PROTOCOL_VERSION'].empty?
  warn "Pinning MCP protocol version to #{ENV.fetch('MCP_PROTOCOL_VERSION')} (unset it to negotiate)."
end

# Hand over to woods-mcp under this same Ruby. Execing the script path would
# go through its `#!/usr/bin/env ruby` line, which can pick another Ruby off
# PATH, and a fresh interpreter forgets any `-I` this launcher was started
# with (`ruby -I <checkout>/lib exe/woods-mcp-start`): a plain `require
# 'woods/...'` would then activate an installed Woods gem instead. Woods' own
# lib is carried forward through RUBYLIB, first, so it wins over another
# checkout's lib already listed there; other entries are kept and, unlike
# RUBYOPT, RUBYLIB takes paths that contain spaces.
# Compare real paths: __dir__ is already resolved, so an -I through a
# symlinked checkout would otherwise never match.
woods_lib = File.expand_path('../lib', __dir__)
woods_lib_entry = lambda do |entry|
  File.realpath(entry.to_s) == woods_lib
rescue SystemCallError
  false
end
if $LOAD_PATH.any?(&woods_lib_entry)
  rubylib = ENV.fetch('RUBYLIB', '').split(File::PATH_SEPARATOR).reject(&:empty?)
  ENV['RUBYLIB'] = [woods_lib, *(rubylib - [woods_lib])].join(File::PATH_SEPARATOR)
end

require 'rbconfig'

# RbConfig.ruby, not Gem.ruby: Gem.ruby wraps a path containing spaces in
# literal quotes for shell use, and this argv-form exec does no unquoting.
exec(RbConfig.ruby, File.expand_path('woods-mcp', __dir__), index_dir)
