#!/usr/bin/env ruby
# frozen_string_literal: true

# Preflight entry point for the Woods Index MCP server: it validates the index
# directory and its published manifest, then `exec`s woods-mcp in place. There
# is no supervision and no restart loop — a crashed woods-mcp stays down, the
# same as when launched directly. RubyGems loads gem executables as Ruby, so
# this wrapper must remain a Ruby program when packaged.

# `--allow-mismatch` (or WOODS_MCP_ALLOW_MISMATCH=1) serves an index that
# another checkout of the repository recorded; without it that is refused.
allow_mismatch = !ARGV.delete('--allow-mismatch').nil?
index_dir = ARGV[0] || ENV.fetch('WOODS_DIR', nil) || ENV.fetch('WOODS_OUTPUT', nil)

if index_dir.nil? || index_dir.empty?
  warn 'Error: No index directory specified.'
  warn 'Usage: woods-mcp-start [--allow-mismatch] /path/to/index_dir'
  exit 1
end

index_dir = File.expand_path(index_dir)
path_remedy = 'Point at the existing index with an explicit path, WOODS_DIR, or WOODS_OUTPUT. ' \
              'If no index exists, run `bundle exec rake woods:extract` in your Rails app.'

unless File.directory?(index_dir)
  warn "Error: Index directory does not exist: #{index_dir}"
  warn path_remedy
  exit 1
end

# Mirrors Woods::Generation#payload_dir + Woods::MCP::Bootstrapper.manifest_present?
# (lib/woods/generation.rb, lib/woods/mcp/bootstrapper.rb) without requiring
# the gem: this pre-flight runs before the `exec` below, so pulling in the
# whole library just to check one file is wasted work on every boot. A
# payload-born index has no manifest.json at the root — it lives under the
# directory generation.json's `payload` pointer names — so the pointer is
# followed here too, with the same realpath containment check, before concluding the
# directory holds no index. woods-mcp re-checks this properly through
# Bootstrapper regardless; this is just an early, friendlier exit.
def manifest_present?(index_dir)
  return true if File.file?(File.join(index_dir, 'manifest.json'))

  generation_path = File.join(index_dir, 'generation.json')
  return false unless File.file?(generation_path)

  require 'json'
  require_relative '../lib/woods/atomic_file'
  payload_name = JSON.parse(Woods::AtomicFile.read(generation_path))['payload']
  return false unless payload_name.is_a?(String) && !payload_name.empty?

  root = File.realpath(index_dir)
  candidate = File.realpath(payload_name, root)
  return false unless candidate.start_with?("#{root}#{File::SEPARATOR}")

  File.file?(File.join(candidate, 'manifest.json'))
rescue JSON::ParserError, SystemCallError, TypeError, NoMethodError
  false
end

unless manifest_present?(index_dir)
  warn "Error: Could not resolve a published Woods index in: #{index_dir}"
  warn 'Expected generation.json pointing to a payload manifest.json, or a legacy flat manifest.json.'
  warn path_remedy
  exit 1
end

# Which checkout the index describes, against the directory this launcher
# runs in. Reads generation.json, the manifest and the checkout's HEAD file
# only, so the handshake stays fast. A root mismatch is refused unless
# allowed; a branch difference or a writer from another Woods build is a
# warning (the server repeats both to the client at connect).
require_relative '../lib/woods/mcp/served_identity'
identity = Woods::MCP::ServedIdentity.read(index_dir)
allow_mismatch ||= Woods::MCP::ServedIdentity.allow_mismatch?
if identity.client_matches == false
  unless allow_mismatch
    warn "Error: #{identity.refusal_message}"
    exit 1
  end

  ENV[Woods::MCP::ServedIdentity::ALLOW_ENV] = '1'
  warn "Warning: serving another checkout's index (mismatch allowed). #{identity.warnings.first}"
end
identity.warnings.drop(identity.client_matches == false ? 1 : 0).each { |message| warn "Warning: #{message}" }

if ENV['MCP_PROTOCOL_VERSION'] && !ENV['MCP_PROTOCOL_VERSION'].empty?
  warn "Pinning MCP protocol version to #{ENV.fetch('MCP_PROTOCOL_VERSION')} (unset it to negotiate)."
end

# Hand over to woods-mcp under this same Ruby. Execing the script path would
# go through its `#!/usr/bin/env ruby` line, which can pick another Ruby off
# PATH, and a fresh interpreter forgets any `-I` this launcher was started
# with (`ruby -I <checkout>/lib exe/woods-mcp-start`): a plain `require
# 'woods/...'` would then activate an installed Woods gem instead. Woods' own
# lib is carried forward through RUBYLIB, first, so it wins over another
# checkout's lib already listed there; other entries are kept and, unlike
# RUBYOPT, RUBYLIB takes paths that contain spaces.
woods_lib = File.expand_path('../lib', __dir__)
if $LOAD_PATH.any? { |entry| File.expand_path(entry.to_s) == woods_lib }
  rubylib = ENV.fetch('RUBYLIB', '').split(File::PATH_SEPARATOR).reject(&:empty?)
  ENV['RUBYLIB'] = [woods_lib, *(rubylib - [woods_lib])].join(File::PATH_SEPARATOR)
end

require 'rbconfig'

# RbConfig.ruby, not Gem.ruby: Gem.ruby wraps a path containing spaces in
# literal quotes for shell use, and this argv-form exec does no unquoting.
exec(RbConfig.ruby, File.expand_path('woods-mcp', __dir__), index_dir)
